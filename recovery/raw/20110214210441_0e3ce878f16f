        <div id="post-729" class="post-729 post type-post hentry category-wpf">

          <div class="post-header">
           <h3 class="post-title"><a href="http://blog.cromwellhaus.com/2008/11/the-wpf-mindset/" rel="bookmark" title="Permanent Link: The WPF Mindset">The WPF Mindset</a></h3>
