<table cellspacing="0" cellpadding="5" width="90%"><tr><td width="33%">string</td><td>blogid</td></tr><tr><td width="33%">string</td><td>username</td></tr><tr><td width="33%">string</td><td>password</td></tr><tr><td width="33%">struct <a href="#MediaObject">MediaObject</a></td><td>mediaObject</td></tr></table>
