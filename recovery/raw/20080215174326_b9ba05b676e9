<table cellspacing="0" cellpadding="5" width="90%"><tr><td width="33%">struct <a href="#Post">Post</a></td><td>&nbsp;</td></tr></table>
</span>
<span>
<h2><a name="#metaWeblog.getRecentPosts">method metaWeblog.getRecentPosts</a></h2>
