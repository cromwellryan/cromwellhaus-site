</pre>
<pre style="background-color: #ffffff; margin: 0em; width: 100%; font-family: consolas, &#39;Courier New&#39;, courier, monospace; font-size: 12px">                       .WithService.Select((t, bt) =&gt;
</pre>
<pre style="background-color: #fbfbfb; margin: 0em; width: 100%; font-family: consolas, &#39;Courier New&#39;, courier, monospace; font-size: 12px">                                               {
</pre>
<pre style="background-color: #ffffff; margin: 0em; width: 100%; font-family: consolas, &#39;Courier New&#39;, courier, monospace; font-size: 12px">                                                   var serviceType = t
</pre>
<pre style="background-color: #fbfbfb; margin: 0em; width: 100%; font-family: consolas, &#39;Courier New&#39;, courier, monospace; font-size: 12px">                                                       .GetInterfaces()
</pre>
<pre style="background-color: #ffffff; margin: 0em; width: 100%; font-family: consolas, &#39;Courier New&#39;, courier, monospace; font-size: 12px">                                                       .Where(x =&gt; x.FullName.StartsWith(&quot;<span style="color: #8b0000">SomeApp</span>&quot;))
</pre>
<pre style="background-color: #fbfbfb; margin: 0em; width: 100%; font-family: consolas, &#39;Courier New&#39;, courier, monospace; font-size: 12px">                                                       .FirstOrDefault();
</pre>
<pre style="background-color: #ffffff; margin: 0em; width: 100%; font-family: consolas, &#39;Courier New&#39;, courier, monospace; font-size: 12px"></pre>
<pre style="background-color: #fbfbfb; margin: 0em; width: 100%; font-family: consolas, &#39;Courier New&#39;, courier, monospace; font-size: 12px">                                                   <span style="color: #0000ff">if</span> (serviceType != <span style="color: #0000ff">null</span>)
</pre>
<pre style="background-color: #ffffff; margin: 0em; width: 100%; font-family: consolas, &#39;Courier New&#39;, courier, monospace; font-size: 12px">                                                       <span style="color: #0000ff">return</span> <span style="color: #0000ff">new</span>[] {serviceType};
</pre>
<pre style="background-color: #fbfbfb; margin: 0em; width: 100%; font-family: consolas, &#39;Courier New&#39;, courier, monospace; font-size: 12px">                                                   <span style="color: #0000ff">else</span>
</pre>
<pre style="background-color: #ffffff; margin: 0em; width: 100%; font-family: consolas, &#39;Courier New&#39;, courier, monospace; font-size: 12px">                                                       <span style="color: #0000ff">return</span> <span style="color: #0000ff">new</span>[] {t};
</pre>
<pre style="background-color: #fbfbfb; margin: 0em; width: 100%; font-family: consolas, &#39;Courier New&#39;, courier, monospace; font-size: 12px">                                               }));</pre>
