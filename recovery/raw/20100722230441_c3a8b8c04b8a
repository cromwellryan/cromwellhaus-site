<pre style="background-color: #fbfbfb; margin: 0em; width: 100%; font-family: consolas,&#39;Courier New&#39;,courier,monospace; font-size: 12px"><span style="color: #0000ff">&lt;</span><span style="color: #800000">Slider</span> <span style="color: #ff0000">x</span>:<span style="color: #ff0000">Name</span>=<span style="color: #0000ff">&quot;scaleSize&quot;</span> <span style="color: #ff0000">Width</span>=<span style="color: #0000ff">&quot;100&quot;</span> <span style="color: #ff0000">HorizontalAlignment</span>=<span style="color: #0000ff">&quot;Center&quot;</span>
</pre>
<pre style="background-color: #fbfbfb; margin: 0em; width: 100%; font-family: consolas,&#39;Courier New&#39;,courier,monospace; font-size: 12px">        <span style="color: #ff0000">Minimum</span>=<span style="color: #0000ff">&quot;2&quot;</span> <span style="color: #ff0000">Maximum</span>=<span style="color: #0000ff">&quot;{Binding ElementName=itemsToScale, Path=Items.Count}&quot;</span>
</pre>
<pre style="background-color: #fbfbfb; margin: 0em; width: 100%; font-family: consolas,&#39;Courier New&#39;,courier,monospace; font-size: 12px">        <span style="color: #ff0000">Value</span>=<span style="color: #0000ff">&quot;{Binding ElementName=itemsToScale, Path=Items.Count, Mode=OneWay}&quot;</span>
</pre>
<pre style="background-color: #fbfbfb; margin: 0em; width: 100%; font-family: consolas,&#39;Courier New&#39;,courier,monospace; font-size: 12px">        <span style="color: #ff0000">IsSnapToTickEnabled</span>=<span style="color: #0000ff">&quot;True&quot;</span> <span style="color: #ff0000">TickFrequency</span>=<span style="color: #0000ff">&quot;1&quot;</span> <span style="color: #0000ff">/&gt;</span>
