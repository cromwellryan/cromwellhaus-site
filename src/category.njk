---
layout: layouts/base.njk
pagination:
  data: collections.categories
  size: 1
  alias: cat
permalink: "/category/{{ cat.name | slugify }}/"
eleventyComputed:
  title: "{{ cat.name }}"
---
<h1>{{ cat.name }}</h1>
<ul class="archive-list">
  {%- for post in cat.posts %}
  <li><time datetime="{{ post.date | isoDate }}">{{ post.date | isoDate }}</time> <a href="{{ post.data.external_url or post.url }}"{% if post.data.external_url %} class="external"{% endif %}>{{ post.data.title }}</a></li>
  {%- endfor %}
</ul>
