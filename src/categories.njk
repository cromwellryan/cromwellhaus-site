---
layout: layouts/base.njk
title: Categories
permalink: /category/
---
<h1>Categories</h1>
<ul class="category-list">
  {%- for cat in collections.categories %}
  <li><a href="/category/{{ cat.name | slugify }}/">{{ cat.name }}</a> <span class="count">{{ cat.posts.length }}</span></li>
  {%- endfor %}
</ul>
