---
layout: layouts/base.njk
pagination:
  data: collections.posts
  size: 10
  alias: posts
permalink: "{% if pagination.pageNumber == 0 %}/{% else %}/page/{{ pagination.pageNumber + 1 }}/{% endif %}"
eleventyComputed:
  title: "{% if pagination.pageNumber > 0 %}Page {{ pagination.pageNumber + 1 }}{% endif %}"
---
<ol class="post-list">
  {%- for post in posts %}
  <li>
    <h2><a href="{{ post.data.external_url or post.url }}"{% if post.data.external_url %} class="external"{% endif %}>{{ post.data.title }}</a></h2>
    <p class="meta"><time datetime="{{ post.date | isoDate }}">{{ post.date | readableDate }}</time></p>
    <p>{{ post.content | summary }}</p>
  </li>
  {%- endfor %}
</ol>

<nav class="pager">
  {%- if pagination.href.previous %}<a rel="prev" href="{{ pagination.href.previous }}">← Newer</a>{% else %}<span></span>{% endif %}
  <span>Page {{ pagination.pageNumber + 1 }} of {{ pagination.pages.length }}</span>
  {%- if pagination.href.next %}<a rel="next" href="{{ pagination.href.next }}">Older →</a>{% else %}<span></span>{% endif %}
</nav>
