---
layout: layouts/base.njk
title: Archive
permalink: /archive/
---
<h1>Archive</h1>
<p>{{ collections.posts.length }} posts since 2005.</p>
{%- for group in collections.postsByYear %}
<section class="year">
  <h2 id="y{{ group.year }}">{{ group.year }}</h2>
  <ul class="archive-list">
    {%- for post in group.posts %}
    <li><time datetime="{{ post.date | isoDate }}">{{ post.date | isoDate }}</time> <a href="{{ post.url }}">{{ post.data.title }}</a></li>
    {%- endfor %}
  </ul>
</section>
{%- endfor %}
