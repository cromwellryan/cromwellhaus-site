<pre style="background-color: #fbfbfb; margin: 0em; width: 100%; font-family: consolas,&#39;Courier New&#39;,courier,monospace; font-size: 12px">                        <span style="color: #0000ff">&lt;</span><span style="color: #800000">GridViewColumn</span> <span style="color: #ff0000">Header</span>=<span style="color: #0000ff">&quot;Latitude&quot;</span> <span style="color: #ff0000">DisplayMemberBinding</span>=<span style="color: #0000ff">&quot;{Binding Latitude}&quot;</span> <span style="color: #0000ff">/&gt;</span>
</pre>
<pre style="background-color: #fbfbfb; margin: 0em; width: 100%; font-family: consolas,&#39;Courier New&#39;,courier,monospace; font-size: 12px">                        <span style="color: #0000ff">&lt;</span><span style="color: #800000">GridViewColumn</span> <span style="color: #ff0000">Header</span>=<span style="color: #0000ff">&quot;Longitude&quot;</span> <span style="color: #ff0000">DisplayMemberBinding</span>=<span style="color: #0000ff">&quot;{Binding Longitude}&quot;</span> <span style="color: #0000ff">/&gt;</span>
</pre>
<pre style="background-color: #fbfbfb; margin: 0em; width: 100%; font-family: consolas,&#39;Courier New&#39;,courier,monospace; font-size: 12px">                    <span style="color: #0000ff">&lt;/</span><span style="color: #800000">GridView</span><span style="color: #0000ff">&gt;</span>
